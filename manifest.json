{
  "manifest_version": 3,
  "name": "InstaKeep",
  "version": "1.0.0",
  "description": "Keep Instagram posts, Reels and Stories playing when you switch tabs or windows.",
  "author": "Antxj",
  "homepage_url": "https://github.com/Antxj/instakeep",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "InstaKeep",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "instakeep@instakeep.extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
