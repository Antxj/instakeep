{
  "name": "instakeep",
  "version": "1.0.0",
  "description": "Firefox extension that keeps Instagram videos playing when you switch tabs or windows.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "web-ext run --start-url https://www.instagram.com/",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "publish": "web-ext sign --channel=listed --amo-metadata amo-metadata.json"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  },
  "webExt": {
    "ignoreFiles": [
      "package.json",
      "package-lock.json",
      "README.md",
      "AMO_LISTING.md",
      "amo-metadata.json",
      "web-ext-artifacts"
    ]
  }
}
